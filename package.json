{
  "name": "stint-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "seed": "node scripts/seed-demo.mjs && node scripts/seed-student.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "node scripts/test-security.mjs && playwright test",
    "dev:secure": "infisical run --env=dev -- next dev -p 3100",
    "seed:secure": "infisical run --env=dev -- npm run seed",
    "test:secure": "infisical run --env=dev -- npm test"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.0",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-pdf": "^11.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
