# Copy to .env.local (scripts/setup-local.sh writes it for you on a local machine)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: password given to the demo logins by scripts/seed-demo.mjs
DEMO_PASSWORD=stint-demo-1234

# Recordings (slice 4). Server only; never prefix with NEXT_PUBLIC_.
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# Optional overrides
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=multi
# GEMINI_MODEL=gemini-3.8-flash

# Interview Coach: where students practise, and the shared secret for one-click sign-in (same value as the Coach STINT_SSO_SECRET)
COACH_URL=http://localhost:3000
COACH_SSO_SECRET=

# In-CRM messaging (server only; see docs/messaging.md). Leave empty to keep messages queued.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
BUILDER_FRAME_ORIGINS=
