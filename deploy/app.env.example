NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SONIOX_API_KEY=
GEMINI_API_KEY=
