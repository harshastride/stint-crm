# Copy to deploy/app.env on the server (chmod 600). Better: fill these from your secret store at deploy time.
CRM_DOMAIN=crm.stintacademy.com
# Address of the Supabase API as the server sees it (Kong of the Supabase compose stack)
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=

# Interview Coach: where students practise, and the shared secret for one-click sign-in (same value as the Coach STINT_SSO_SECRET)
COACH_URL=http://localhost:3000
COACH_SSO_SECRET=

# Idle sign-out is set on the Supabase auth service, not here: GOTRUE_SESSIONS_INACTIVITY_TIMEOUT=30m (see README step 4b).
# The on-screen timer reads the idle_signout_minutes setting.
